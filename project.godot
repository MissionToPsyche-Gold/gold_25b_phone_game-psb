; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Cosmic Quest: Psyche"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.043, 0.031, 0.125, 1)
config/icon="res://icon.png"

[autoload]

GameSettings="*res://scripts/autoload/game_settings.gd"
UITheme="*res://scripts/autoload/ui_theme.gd"
SceneTransition="*res://scripts/autoload/scene_transition.gd"
GameState="*res://models/game_state.gd"
GameFlow="*res://controllers/game_controller.gd"
Backdrop="*res://scripts/autoload/backdrop.gd"
QuestionBank="*res://scripts/autoload/question_bank.gd"

[display]

window/size/viewport_width=360
window/size/viewport_height=640
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.043, 0.031, 0.125, 1)

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")
